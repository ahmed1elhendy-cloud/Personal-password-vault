<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PasswordVault.App.UnlockPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Unlock vault">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label
            Text="Unlock your vault"
            FontSize="28"
            FontAttributes="Bold" />
        <Entry
            x:Name="PasswordEntry"
            Placeholder="Password"
            IsPassword="True"
            ReturnType="Go"
            Completed="OnUnlockClicked" />
        <Label
            x:Name="ErrorLabel"
            Text="Wrong password"
            TextColor="Red"
            IsVisible="False" />
        <ActivityIndicator
            x:Name="BusyIndicator"
            IsVisible="False"
            IsRunning="False" />
        <Button
            x:Name="FingerprintButton"
            Text="Unlock with fingerprint"
            IsVisible="False"
            Clicked="OnFingerprintUnlockClicked" />
        <Button
            x:Name="UnlockButton"
            Text="Unlock"
            Clicked="OnUnlockClicked" />
    </VerticalStackLayout>
</ContentPage>
