<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PasswordVault.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Settings">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label
            FontAttributes="Bold"
            FontSize="28"
            Text="Settings" />
        <Button
            Clicked="OnCategoriesClicked"
            HorizontalOptions="Fill"
            Text="Manage categories" />
        <Button
            Clicked="OnImportCsvClicked"
            HorizontalOptions="Fill"
            Text="Import CSV" />
        <Button
            Clicked="OnExportCsvClicked"
            HorizontalOptions="Fill"
            Text="Export CSV" />
        <Button
            Clicked="OnSaveBackupClicked"
            HorizontalOptions="Fill"
            Text="Save backup file" />
        <Button
            Clicked="OnImportBackupClicked"
            HorizontalOptions="Fill"
            Text="Import backup file" />
        <Label
            FontAttributes="Bold"
            FontSize="20"
            Text="Google Drive sync" />
        <Label
            x:Name="GoogleSyncStatusLabel"
            Text="Sync is off." />
        <Label
            x:Name="LastSyncedLabel"
            Text="Not synced yet." />
        <Button
            x:Name="GoogleSignInButton"
            Clicked="OnGoogleSignInClicked"
            HorizontalOptions="Fill"
            Text="Sign in and turn on sync" />
        <Button
            x:Name="GoogleSyncNowButton"
            Clicked="OnGoogleSyncNowClicked"
            HorizontalOptions="Fill"
            IsEnabled="False"
            Text="Sync now" />
        <ActivityIndicator
            x:Name="GoogleSyncBusyIndicator"
            IsVisible="False"
            IsRunning="False" />
    </VerticalStackLayout>
</ContentPage>
