<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PasswordVault.App</RootNamespace>
    <ApplicationTitle>PasswordVault</ApplicationTitle>
    <ApplicationId>com.passwordvault.app</ApplicationId>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\GoogleConfig.cs')">
    <DefineConstants>$(DefineConstants);HAS_LOCAL_GOOGLE_CONFIG</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.33" Condition="'$(TargetFramework)' == 'net10.0-android'" />
    <PackageReference Include="Xamarin.GooglePlayServices.Auth" Version="122.0.0" Condition="'$(TargetFramework)' == 'net10.0-android'" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.1" Condition="'$(TargetFramework)' == 'net10.0-android'" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" Condition="'$(TargetFramework)' == 'net10.0-android'" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" Condition="'$(TargetFramework)' == 'net10.0-android'" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" Condition="'$(TargetFramework)' == 'net10.0-android'" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B6E8F" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B6E8F" BaseSize="128,128" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PasswordVault.Core\PasswordVault.Core.csproj" />
  </ItemGroup>
</Project>
