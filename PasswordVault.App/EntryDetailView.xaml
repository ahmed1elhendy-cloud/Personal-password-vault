<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="PasswordVault.App.EntryDetailView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label
                x:Name="TitleLabel"
                FontAttributes="Bold"
                FontSize="28" />
            <Label
                x:Name="CategoryLabel"
                Padding="12,6"
                HorizontalOptions="Start"
                TextColor="White" />
            <VerticalStackLayout Spacing="4">
                <Label FontSize="12" Text="WEBSITE" TextColor="#52666E" />
                <Label x:Name="WebsiteLabel" />
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label FontSize="12" Text="USERNAME" TextColor="#52666E" />
                    <Label x:Name="UsernameLabel" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Clicked="OnCopyUsernameClicked"
                    Text="Copy"
                    VerticalOptions="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <VerticalStackLayout Spacing="4">
                    <Label FontSize="12" Text="PASSWORD" TextColor="#52666E" />
                    <Label x:Name="PasswordLabel" />
                </VerticalStackLayout>
                <Button
                    x:Name="PasswordEyeButton"
                    Grid.Column="1"
                    Clicked="OnPasswordEyeClicked"
                    Text="👁"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="2"
                    Clicked="OnCopyPasswordClicked"
                    Text="Copy"
                    VerticalOptions="Center" />
            </Grid>
            <VerticalStackLayout
                x:Name="CustomFieldsList"
                Spacing="12" />
            <VerticalStackLayout Spacing="4">
                <Label FontSize="12" Text="NOTES" TextColor="#52666E" />
                <Label x:Name="NotesLabel" />
            </VerticalStackLayout>
            <Button
                BackgroundColor="#0B6E8F"
                Clicked="OnCopyPasswordClicked"
                Text="Copy password"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
